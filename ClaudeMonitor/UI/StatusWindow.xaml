<Window x:Class="ClaudeMonitor.UI.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ClaudeMonitor.Models"
        xmlns:ui="clr-namespace:ClaudeMonitor.UI"
        Title="CC-Pulse"
        Width="220" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Status to color converter -->
        <ui:StatusToColorConverter x:Key="StatusToColorConverter" />
        <ui:StatusToTextConverter x:Key="StatusToTextConverter" />
        <ui:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Drop shadow border style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FF1E1E2E" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Session item template -->
        <DataTemplate DataType="{x:Type models:SessionInfo}">
            <StackPanel Margin="0,4">
                <!-- Project name (no indicator) -->
                <TextBlock Text="{Binding DisplayName}"
                           Foreground="#FFE0E0E0"
                           FontSize="12"
                           FontWeight="Medium"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,2" />

                <!-- Main agent row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Main agent indicator (red=Busy, green=Idle) -->
                    <Ellipse Grid.Column="0"
                             Width="8" Height="8"
                             Fill="{Binding IsWorking, Converter={StaticResource StatusToColorConverter}}"
                             VerticalAlignment="Center"
                             Margin="0,0,4,0" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding MainStatusText}"
                               Foreground="{Binding IsWorking, Converter={StaticResource StatusToColorConverter}}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Single subagent status row (fine-grained). Hidden until the
                     session has spawned at least one subagent (HasSubagentActivity
                     latches on first detection), then always visible: red while
                     any subagent is working (showing the active state — thinking,
                     running: <tool>, waiting for API…), green once all subagents
                     have reached a terminal state (done/failed) before the row is
                     removed by SubagentStop/watcher. -->
                <Grid Margin="0,1,0,0"
                      Visibility="{Binding HasSubagentActivity, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Subagent indicator (red=Working, green=Idle) -->
                    <Ellipse Grid.Column="0"
                             Width="8" Height="8"
                             Fill="{Binding SubagentWorking, Converter={StaticResource StatusToColorConverter}}"
                             VerticalAlignment="Center"
                             Margin="0,0,4,0" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding SubagentStatusText}"
                               Foreground="{Binding SubagentWorking, Converter={StaticResource StatusToColorConverter}}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border Style="{StaticResource CardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="CC-Pulse"
                           Foreground="#FFCDD6F4"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <!-- Close button (minimizes to tray) -->
                <Button Grid.Column="1"
                        Content="✕"
                        Click="CloseButton_Click"
                        Background="Transparent"
                        Foreground="#FFA0A0A0"
                        BorderThickness="0"
                        FontSize="12"
                        Padding="4,0"
                        Cursor="Hand"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- Session list -->
            <ItemsControl Grid.Row="1"
                          x:Name="SessionList"
                          ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Empty state -->
            <TextBlock Grid.Row="1"
                       x:Name="EmptyMessage"
                       Foreground="#FF6C7086"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Visible" />
        </Grid>
    </Border>
</Window>
